# ============================================================
# Stack32 — environment variables
# Copy to apps/web/.env.local for the frontend and
# services/agent-service/.env for the Python service.
# ============================================================

# ---- Mock mode (Phase 1 default) ---------------------------
# When "true", the frontend runs entirely on local mock data:
# mock auth, mock agents, simulated builds — no external services needed.
NEXT_PUBLIC_USE_MOCK_DATA=true

# ---- Frontend base URLs ------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AGENT_SERVICE_URL=http://localhost:8000

# ---- Supabase (optional in mock mode) ----------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# ---- Whop billing (Phase 1: scaffold only) -----------------
NEXT_PUBLIC_WHOP_PLAN_ID=
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=

# ---- Python agent-service ----------------------------------
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
SUPABASE_URL=
SUPABASE_JWT_SECRET=
LOG_LEVEL=INFO
