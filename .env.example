# ============================================================
# Stack32 — environment variables (names only, no secrets)
# Copy to apps/web/.env.local for the frontend and
# services/agent-service/.env for the Python service.
# All values are found in the Supabase dashboard:
#   Project Settings → API (URL, publishable key, service role key)
# ============================================================

# ---- Frontend public (safe for the browser) ----------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# New publishable key format (sb_publishable_...). Preferred.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT key. Used as fallback when no publishable key is set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "supabase" (production) or "mock" (isolated frontend development)
NEXT_PUBLIC_DATA_MODE=supabase
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_AGENT_SERVICE_URL=http://localhost:8000

# ---- Frontend server-only (NEVER prefix with NEXT_PUBLIC_) --
SUPABASE_SERVICE_ROLE_KEY=
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_INTERNAL_TOKEN=
# "mock" (simulated builder/live) or "disabled" (no AI execution)
AI_EXECUTION_MODE=mock
# "mock" (simulated active subscription in dev) or "whop" (Phase 7)
BILLING_MODE=mock

# ---- Whop billing (scaffold only, Phase 7) ------------------
NEXT_PUBLIC_WHOP_PLAN_ID=
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=

# ---- Python agent-service (services/agent-service/.env) -----
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
# Legacy HS256 secret (only if the project uses the legacy JWT secret)
SUPABASE_JWT_SECRET=
APP_ORIGIN=http://localhost:3000
INTERNAL_SERVICE_TOKEN=
DATABASE_URL=
SENTRY_DSN=
