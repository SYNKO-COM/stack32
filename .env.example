# ============================================================
# Stack32 — environment variables (names only, no secrets)
# Copy to apps/web/.env.local for the frontend and
# services/agent-service/.env for the Python service.
# ============================================================

# ---- Frontend public (safe for the browser) ----------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DATA_MODE=supabase
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Public hCaptcha sitekey (optional). Secret is only in Supabase Auth dashboard.
NEXT_PUBLIC_HCAPTCHA_SITEKEY=
# Prefer server-side AGENT_SERVICE_URL; public URL is optional for diagnostics only.
NEXT_PUBLIC_AGENT_SERVICE_URL=http://localhost:8000

# ---- Frontend server-only (NEVER prefix with NEXT_PUBLIC_) --
SUPABASE_SERVICE_ROLE_KEY=
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_INTERNAL_TOKEN=
# mock | agent-service | disabled
AI_EXECUTION_MODE=mock
BILLING_MODE=mock

# ---- Whop billing (production: BILLING_MODE=whop) ----------
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=
WHOP_PRODUCT_STARTER_ID=
WHOP_PRODUCT_PRO_ID=
WHOP_PRODUCT_SCALE_ID=
WHOP_PLAN_STARTER_MONTHLY_ID=
WHOP_PLAN_STARTER_ANNUAL_ID=
WHOP_PLAN_PRO_MONTHLY_ID=
WHOP_PLAN_PRO_ANNUAL_ID=
WHOP_PLAN_SCALE_MONTHLY_ID=
WHOP_PLAN_SCALE_ANNUAL_ID=

# ---- Python agent-service ----------------------------------
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_SECRET=
# Opt-in ONLY for local stubs. Must be false in production.
ALLOW_UNVERIFIED_JWT=false
APP_ORIGIN=http://localhost:3000
INTERNAL_SERVICE_TOKEN=
# Direct Postgres URL for LangGraph checkpoints (server-only, never expose to browser)
DATABASE_URL=
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# mock | live | disabled — agent-service execution mode
# (web AI_EXECUTION_MODE=agent-service should pair with live or mock here)
AI_EXECUTION_MODE=mock
# Generated-agent runner: legacy (manual while) | langgraph (StateGraph + checkpoints)
AGENT_RUNTIME_VERSION=legacy
# true = execute runs inline and skip enqueue (local). false = enqueue only for workers.
QUEUE_INLINE=true
QUEUE_WORKER_ENABLED=false

# ---- Google OAuth (M4 connections — optional until journeys D/E) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/connections/google/callback

# ---- Cost / quotas (Starter ~$20 plan target) --------------
MONTHLY_USER_BUDGET_USD=10.0
MAX_CONCURRENT_BUILDER_RUNS=2
MAX_CONCURRENT_LIVE_RUNS=3
MAX_REPAIR_ATTEMPTS=2
MAX_QUALITY_LOOPS=6
MAX_CRITIQUE_ROUNDS=2
MAX_LLM_CALLS_PER_RUN=28
MAX_LLM_CALLS_PER_CODING_REPAIR=16
RATE_LIMIT_PER_USER_PER_MINUTE=60
RATE_LIMIT_PER_IP_PER_MINUTE=120

# ---- Optional LLM provider keys (at least one required for live) ----
# Create at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Create at: https://console.x.ai/
XAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# ---- BYOK (user LLM keys encrypted at rest) ----------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
# Live runtime requires the user's own key (Builder may use platform keys)
LIVE_REQUIRE_USER_LLM_KEY=true

# ---- LiteLLM / model profiles ------------------------------
LITELLM_MASTER_KEY=
LITELLM_CONFIG_PATH=
MODEL_CONFIG_PATH=services/model-gateway/config/models.yaml
MODEL_FAST_PRIMARY=openai/gpt-4.1-mini
MODEL_FAST_FALLBACK=xai/grok-3-mini
MODEL_BALANCED_PRIMARY=openai/gpt-4.1-mini
MODEL_BALANCED_FALLBACK=xai/grok-3-mini
MODEL_REASONING_PRIMARY=xai/grok-4.5
MODEL_REASONING_FALLBACK=openai/gpt-4.1
MODEL_CODING_PRIMARY=openai/gpt-4.1
MODEL_CODING_FALLBACK=xai/grok-code-fast-1
MODEL_VALIDATOR_PRIMARY=openai/gpt-4.1-mini
MODEL_VALIDATOR_FALLBACK=xai/grok-3-mini
MODEL_EMBEDDING_PRIMARY=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ---- Tools -------------------------------------------------
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=

# ---- Pipedream Connect (optional hybrid integrations) ------
# Create at: https://pipedream.com/settings/api
# When unset, Pipedream provider runs in degraded/mock mode.
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=
PIPEDREAM_ENVIRONMENT=development
PIPEDREAM_ALLOWED_ORIGINS=[]

# ---- Builder coding sandbox (E2B) --------------------------
# Master switch for isolated coding workspaces.
BUILDER_SANDBOX_ENABLED=false
# local = confined temp dir (dev/tests only — forbidden in production)
# e2b = Firecracker microVMs (production). Create key at https://e2b.dev/dashboard
SANDBOX_PROVIDER=local
E2B_API_KEY=
E2B_TEMPLATE=base
SANDBOX_COMMAND_TIMEOUT_SECONDS=120
SANDBOX_WALL_CLOCK_SECONDS=900
SANDBOX_MAX_OUTPUT_BYTES=200000
SANDBOX_MAX_FILE_BYTES=2000000
SANDBOX_ALLOW_NETWORK=false

# ---- Email notifications (scheduled runs) ------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no_reply@stack32.com
EMAIL_FROM_NAME=Stack32
EMAIL_ENABLED=false

# ---- Queue / GCP -------------------------------------------
# QUEUE_BACKEND:
#   postgres     — local/dev/test (writes run_queue; optional QUEUE_WORKER_ENABLED)
#   cloud_tasks  — staging/production (Google Cloud Tasks HTTP → /v1/internal/tasks/run)
#
# Environments:
#   development — QUEUE_BACKEND=postgres, QUEUE_INLINE=true
#   test        — postgres; never require GOOGLE_APPLICATION_CREDENTIALS
#   staging     — cloud_tasks + real GCP project
#   production  — cloud_tasks; /ready fails if GCP config missing
QUEUE_BACKEND=postgres
CLOUD_TASKS_QUEUE=
# Full URL, e.g. https://AGENT_API/v1/internal/tasks/run
CLOUD_TASKS_TARGET_URL=
# OIDC service account email used by Cloud Tasks to invoke Cloud Run (optional if
# INTERNAL_SERVICE_TOKEN is attached as X-Internal-Token on the task).
CLOUD_TASKS_OIDC_SERVICE_ACCOUNT=
# Audience for OIDC token; defaults to CLOUD_TASKS_TARGET_URL when empty.
CLOUD_TASKS_OIDC_AUDIENCE=
GCP_PROJECT_ID=
GCP_LOCATION=europe-west1
# ADC path only for local experiments against GCP — not required for pytest.
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_CLOUD_PROJECT=   # fallback if GCP_PROJECT_ID unset
